# Copy to .env (git-ignored) and adjust. Never commit real secrets.

# ---------- PostgreSQL (db container) ----------
POSTGRES_USER=finpilot
POSTGRES_PASSWORD=finpilot_dev_password
POSTGRES_DB=finpilot

# ---------- API ----------
NODE_ENV=development
PORT=8000
LOG_LEVEL=info
# Used when the API runs on your machine. Docker Compose overrides the host with "db".
# (Keep the password URL-safe: letters, digits, "_" or "-".)
DATABASE_URL=postgres://finpilot:finpilot_dev_password@localhost:5432/finpilot
# Must be 32+ characters. Generate a real one with: openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me-before-any-real-deployment-0123456789
JWT_EXPIRES_HOURS=8
# "true" only when the site is served over HTTPS
COOKIE_SECURE=false
# Browser origins allowed to call the API (also the Origin allow-list for POST/PATCH)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Number of reverse proxies in front of the API (Compose sets 1)
TRUST_PROXY=0
API_RATE_LIMIT_PER_MIN=600
LOGIN_RATE_LIMIT_MAX=10

# ---------- Seed (demo data) ----------
# Folder holding the supplied CSVs (Compose mounts ./data at /data)
DATA_DIR=../data
SEED_ON_START=false
SEED_ADMIN_EMAIL=admin@finpilot.test
SEED_ADMIN_PASSWORD=Admin@12345
SEED_VIEWER_EMAIL=viewer@finpilot.test
SEED_VIEWER_PASSWORD=Viewer@12345
